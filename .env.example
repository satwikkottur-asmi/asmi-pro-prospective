# Waitlist backend origin (required in production). Contract: docs/backend_contracts.md
VITE_API_BASE_URL=

# Public site origin for absolute og:image / og:url (optional; Vercel builds fall back to the production domain)
VITE_SITE_URL=

# true → fake the waitlist API in the browser (src/lib/api-mock.ts); no backend needed
MOCK_API_CALL=false
